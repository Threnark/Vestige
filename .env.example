# COMMAND-LINE TOOL ONLY (the desktop app never reads this file).
# Copy to .env, fill in, and NEVER commit it or paste its contents anywhere.
# Anyone who can read this file can read your mail, so keep it somewhere you trust.

# One app password per account listed in accounts.yaml (APP passwords, not login passwords).
GMAIL_PERSONAL_APP_PASSWORD=xxxx xxxx xxxx xxxx
YAHOO_OLD_APP_PASSWORD=xxxxxxxxxxxxxxxx

# AI key for the cloud AI you use with the CLI (the names are only a default; see --api-key-env).
# Not needed if you use a local AI (--local).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
